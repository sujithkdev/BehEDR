# ============================================================
#  EDR Server — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── Required secrets (CHANGE ALL OF THESE) ──────────────────
# Agent ↔ server shared API key.
# Use: python -c "import secrets; print(secrets.token_hex(32))"
EDR_API_KEY=CHANGE-ME-generate-with-secrets.token_hex-32

# JWT signing secret for dashboard sessions (min 32 chars).
# Use: python -c "import secrets; print(secrets.token_urlsafe(48))"
EDR_JWT_SECRET=CHANGE-ME-generate-with-secrets.token_urlsafe-48

# Flask session cookie secret.
# Use: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE-ME-generate-with-secrets.token_hex-32

# ── TLS ─────────────────────────────────────────────────────
# Set to "true" to enable HTTPS.
# A self-signed cert is auto-generated at data/server.crt on first run.
EDR_TLS_ENABLED=true

# Override default cert/key paths (optional — defaults to data/).
# EDR_TLS_CERT=/etc/ssl/edr/server.crt
# EDR_TLS_KEY=/etc/ssl/edr/server.key

# ── Agent TLS ────────────────────────────────────────────────
# These are set on the *agent* machine, not the server.
# EDR_TLS_ENABLED=true
# EDR_TLS_CA_CERT=/path/to/data/server.crt   # copy from the server
# EDR_SERVER_IP=192.168.1.10

# ── Server ──────────────────────────────────────────────────
EDR_PORT=5000

# ── Optional integrations ────────────────────────────────────
# VirusTotal (leave blank to disable)
# VT_API_KEY=your-virustotal-api-key

# Slack incoming webhook (leave blank to disable)
# EDR_NOTIFY_SLACK_URL=https://hooks.slack.com/services/...

# Microsoft Teams incoming webhook (leave blank to disable)
# EDR_NOTIFY_TEAMS_URL=https://outlook.office.com/webhook/...

# Email alerts (all four required to enable email)
# EDR_NOTIFY_EMAIL_HOST=smtp.example.com
# EDR_NOTIFY_EMAIL_PORT=587
# EDR_NOTIFY_EMAIL_USER=alerts@example.com
# EDR_NOTIFY_EMAIL_PASS=your-smtp-password
# EDR_NOTIFY_EMAIL_TO=soc@example.com

# PagerDuty Events API v2 integration key (leave blank to disable)
# EDR_NOTIFY_PD_KEY=your-pagerduty-routing-key

# ── Advanced ─────────────────────────────────────────────────
# IOC feed refresh interval in hours (default 6)
# EDR_IOC_REFRESH_HOURS=6

# Enable /simulate endpoint for demo/testing ONLY
# EDR_DEV_MODE=false
